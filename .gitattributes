# Git attributes for JavaScript, TypeScript, and web-development course work.
#
# Policy:
# - Store text files normalized with LF in the repository.
# - Keep source, docs, and config files as LF in working trees on every OS.
# - Use CRLF only for Windows command/script files that conventionally expect it.
# - Mark binary assets explicitly so Git does not attempt line-ending conversion.

* text=auto

# Source code
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.astro   text eol=lf
*.vue     text eol=lf
*.svelte  text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.sass    text eol=lf
*.less    text eol=lf
*.html    text eol=lf
*.htm     text eol=lf
*.xml     text eol=lf
*.svg     text eol=lf

# Documentation and course content
*.md       text eol=lf
*.mdx      text eol=lf
*.markdown text eol=lf
*.txt      text eol=lf
*.adoc     text eol=lf
README     text eol=lf
ReadMe     text eol=lf
LICENSE    text eol=lf
TODO       text eol=lf

# Data and configuration
*.json              text eol=lf
*.jsonc             text eol=lf
*.yaml              text eol=lf
*.yml               text eol=lf
*.toml              text eol=lf
*.ini               text eol=lf
*.conf              text eol=lf
*.config            text eol=lf
*.csv               text eol=lf
*.tsv               text eol=lf
*.sql               text eol=lf
.editorconfig       text eol=lf
.gitattributes      text eol=lf
.gitattributes-*    text eol=lf
.gitignore          text eol=lf
.npmignore          text eol=lf
.prettierignore     text eol=lf
.prettierrc         text eol=lf
.eslintrc           text eol=lf
.eslintignore       text eol=lf
.stylelintrc        text eol=lf
.browserslistrc     text eol=lf
package.json        text eol=lf
package-lock.json   text eol=lf
pnpm-lock.yaml      text eol=lf
yarn.lock           text eol=lf

# Shell and platform-specific scripts
*.sh   text eol=lf
*.bash text eol=lf
*.zsh  text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Tooling files
Dockerfile       text eol=lf
*.dockerignore   text eol=lf
Makefile         text eol=lf
makefile         text eol=lf

# Images and media
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.bmp   binary
*.tif   binary
*.tiff  binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.mp4   binary
*.webm  binary
*.mov   binary

# Documents and archives
*.pdf   binary
*.doc   binary
*.docx  binary
*.ppt   binary
*.pptx  binary
*.xls   binary
*.xlsx  binary
*.zip   binary
*.gz    binary
*.tar   binary
*.7z    binary
*.rar   binary

# Fonts and executables
*.ttf    binary
*.otf    binary
*.eot    binary
*.woff   binary
*.woff2  binary
*.exe    binary
*.dll    binary
